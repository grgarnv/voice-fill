# Copy to .env and fill in. NEVER commit .env.
RIME_API_KEY=rime_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# coda is Rime's flagship (2026-09-06 switch from mistv2; see README "Model").
# Preflight probe 00 verifies the speaker exists for RIME_MODEL_ID in the live catalog.
RIME_MODEL_ID=coda
RIME_SPEAKER=astra
RIME_SPEAKER_FALLBACK=luna
RIME_LANG=eng

# pcm is the Phase 0 decision (sample-accurate playback clock for the heard ledger).
# mp3 retained only for A/B in probe 04.
RIME_AUDIO_FORMAT=pcm

RIME_REST_URL=https://users.rime.ai/v1/rime-tts
RIME_WS_URL=wss://users-ws.rime.ai/ws3
RIME_PHONEMIZE_URL=https://optimize.rime.ai/phonemize
RIME_CATALOG_URL=https://users.rime.ai/data/voices/all-v2.json

# Backend proxy
PORT=8787
# Shared token so the proxy is not an open relay to your Rime key.
PROXY_TOKEN=change-me-before-demo
ALLOWED_ORIGIN=chrome-extension://
